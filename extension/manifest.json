{
   "manifest_version": 3,
   "name": "__MSG_extName__",
   "version": "2.1.0",
   "description": "__MSG_extDescription__",
   "default_locale": "en",
   "author": "Aadit Aggarwal",
   "minimum_chrome_version": "111",
   "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   },
   "action": {
      "default_icon": {
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png",
         "128": "icons/icon128.png"
      },
      "default_popup": "src/popup/popup.html",
      "default_title": "__MSG_extName__"
   },
   "options_page": "src/settings/settings.html",
   "background": {
      "service_worker": "src/background/background.js"
   },
   "content_scripts": [
      {
         "all_frames": true,
         "js": [
            "src/content/injected.js"
         ],
         "match_about_blank": true,
         "match_origin_as_fallback": true,
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_start",
         "world": "MAIN"
      },
      {
         "all_frames": true,
         "js": [
            "src/content/content.js"
         ],
         "match_about_blank": true,
         "match_origin_as_fallback": true,
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_start"
      }
   ],
   "commands": {
      "toggle-current-tab": {
         "description": "__MSG_cmdToggle__",
         "suggested_key": {
            "default": "Ctrl+Shift+A",
            "mac": "Command+Shift+A"
         }
      },
      "disable-all-tabs": {
         "description": "__MSG_cmdDisableAll__",
         "suggested_key": {
            "default": "Ctrl+Shift+D",
            "mac": "Command+Shift+D"
         }
      }
   },
   "permissions": [
      "tabs",
      "storage",
      "scripting",
      "notifications",
      "alarms",
      "offscreen"
   ],
   "host_permissions": [
      "<all_urls>"
   ],
   "homepage_url": "https://tabrevive.aadit.dev"
}
